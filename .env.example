# ---------- frontend (frontend/.env.production / .env.development) ----------
# Empty = same origin (production behind nginx). Dev uses the Vite proxy, so leave empty too.
VITE_API_URL=
VITE_CLOUDFLARE_WORKER_URL=https://pmtiles-worker.mallhintdr.workers.dev
VITE_TURNSTILE_SITE_KEY=
# Set to "true" to show Cloudflare Turnstile on public registration (default off, decision D9)
VITE_ENABLE_TURNSTILE=false

# ---------- website (site/, build time) ----------
# PUBLIC_SITE_URL=https://naqsha-zameen.com
# PUBLIC_DASHBOARD_URL=https://dashboard.naqsha-zameen.com

# ---------- backend (backend/.env) ----------
# Public addresses (utils/siteConfig.js)
# APP_URL=https://dashboard.naqsha-zameen.com
# SITE_URL=https://naqsha-zameen.com
# ALLOWED_DOMAINS=naqsha-zameen.com,naqsha-zameen.pk
# COOKIE_DOMAIN=.naqsha-zameen.com
# false = run no scheduled tasks or queue workers (parallel test copy sharing the production database)
# JOBS_ENABLED=true
# VAPID_CONTACT=mailto:admin@naqsha-zameen.pk
# MONGO_URI=
# SECRET_KEY=            (>= 32 chars)
# PORT=5000
# NODE_ENV=production
# CORS_ORIGIN=        (optional extra allowed origins, comma-separated)
# CLOUDFLARE_WORKER_URL=https://pmtiles-worker.mallhintdr.workers.dev   (set explicitly; REACT_APP_ name is legacy)
# PMTILES_SIGNING_KEY=
# REDIS_ENABLED=true
# VAPID_PUBLIC_KEY= / VAPID_PRIVATE_KEY=
# SMTP_HOST= SMTP_PORT= SMTP_USER= SMTP_PASS= FROM_EMAIL= FROM_NAME=
# TURNSTILE_SECRET_KEY=
# ADMIN_REPORT_EMAIL=
