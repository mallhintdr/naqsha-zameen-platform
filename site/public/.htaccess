# Apache / cPanel hosting (o3host). Nginx hosts ignore this file.
# Rules apply ONLY to naqsha-zameen.pk / www.naqsha-zameen.pk, never to subdomains
# (dashboard.*, api.*) whose folders may sit inside public_html.

RewriteEngine On

# www -> plain domain
RewriteCond %{HTTP_HOST} ^www\.naqsha-zameen\.pk$ [NC]
RewriteRule ^ https://naqsha-zameen.pk%{REQUEST_URI} [L,R=301]

# http -> https (also behind a proxy such as Cloudflare)
RewriteCond %{HTTP_HOST} ^naqsha-zameen\.pk$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://naqsha-zameen.pk%{REQUEST_URI} [L,R=301]

DirectoryIndex index.html
ErrorDocument 404 /404.html

AddType image/svg+xml .svg

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
