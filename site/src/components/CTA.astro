---
import Icon from './Icon.astro';
import { SITE, waLink } from '../site';
interface Props {
  title?: string;
  text?: string;
  waText?: string;
}
const {
  title = 'Ready to See Your Land Clearly?',
  text = 'Start a free 24-hour trial of the dashboard, or message us on WhatsApp to book an RTK or drone survey.',
  waText,
} = Astro.props;
---
<section class="mx-auto mt-24 max-w-7xl px-4 sm:px-6 lg:px-8">
  <div class="reveal relative overflow-hidden rounded-[2rem] border border-white/10 bg-gradient-to-br from-indigo-600 via-indigo-700 to-cyan-700 p-8 shadow-2xl shadow-indigo-900/50 sm:p-14">
    <div class="grid-bg absolute inset-0 opacity-60"></div>
    <div class="absolute -right-20 -top-20 size-72 rounded-full bg-cyan-300/30 blur-3xl"></div>
    <div class="relative flex flex-col items-start gap-8 lg:flex-row lg:items-center lg:justify-between">
      <div class="max-w-2xl">
        <h2 class="font-display text-3xl font-extrabold text-white sm:text-4xl">{title}</h2>
        <p class="mt-3 text-lg text-indigo-100">{text}</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href={SITE.registerUrl} class="inline-flex items-center gap-2 rounded-xl bg-white px-6 py-3 font-semibold text-indigo-700 shadow-lg transition hover:-translate-y-0.5">
          Start free trial <Icon name="arrow" class="size-4" />
        </a>
        <a href={waLink(waText)} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-xl border border-white/30 bg-white/10 px-6 py-3 font-semibold text-white backdrop-blur transition hover:-translate-y-0.5 hover:bg-white/20">
          <Icon name="whatsapp" class="size-5" /> WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>
