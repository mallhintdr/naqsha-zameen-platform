---
// Illustrated phone + dashboard mock: murabba split into 25 killas over fields.
const killas = Array.from({ length: 25 }, (_, i) => i + 1);
const highlight = new Set([7, 8, 12, 13]);
---
<div class="relative mx-auto w-full max-w-xl">
  <div class="absolute -inset-10 -z-10 rounded-full bg-gradient-to-tr from-indigo-600/40 via-cyan-500/25 to-emerald-400/20 blur-3xl"></div>

  <!-- Desktop window -->
  <div class="float overflow-hidden rounded-3xl border border-white/15 bg-slate-900/80 shadow-2xl shadow-indigo-900/50">
    <div class="flex items-center gap-2 border-b border-white/10 bg-gradient-to-r from-[#0b1033] via-[#1a237e] to-[#0b4a6f] px-4 py-2.5">
      <span class="size-2.5 rounded-full bg-rose-400"></span><span class="size-2.5 rounded-full bg-amber-300"></span><span class="size-2.5 rounded-full bg-emerald-400"></span>
      <div class="ml-3 flex gap-1.5 text-[10px] font-semibold text-white">
        <span class="rounded-md border border-white/20 bg-white/10 px-2 py-0.5">Tehsil ▾</span>
        <span class="rounded-md border border-cyan-300/50 bg-cyan-400/20 px-2 py-0.5">Chak 47/GD ▾</span>
        <span class="rounded-md border border-white/20 bg-white/10 px-2 py-0.5">Murabba 12 ▾</span>
      </div>
    </div>
    <div class="relative aspect-[4/3]">
      <svg viewBox="0 0 400 300" class="absolute inset-0 size-full" role="img" aria-label="Map showing a murabba divided into 25 numbered killas over satellite fields">
        <defs>
          <linearGradient id="f1" x1="0" x2="1" y1="0" y2="1"><stop offset="0" stop-color="#2f4d22" /><stop offset="1" stop-color="#4a6b2c" /></linearGradient>
          <linearGradient id="f2" x1="0" x2="1"><stop offset="0" stop-color="#6b7a35" /><stop offset="1" stop-color="#8b8a45" /></linearGradient>
          <linearGradient id="f3" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#3b5b2a" /><stop offset="1" stop-color="#26401c" /></linearGradient>
          <pattern id="rows" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(12)"><path d="M0 0v6" stroke="#000" stroke-opacity=".12" stroke-width="2" /></pattern>
        </defs>
        <!-- fields -->
        <rect width="400" height="300" fill="#2b3f1e" />
        <path d="M0 0h150l-10 120H0z" fill="url(#f1)" />
        <path d="M150 0h130l10 90-150 30z" fill="url(#f2)" />
        <path d="M280 0h120v140l-110-50z" fill="url(#f3)" />
        <path d="M0 120h140l-20 180H0z" fill="url(#f2)" />
        <path d="M290 90l110 50v160H260z" fill="url(#f1)" />
        <rect width="400" height="300" fill="url(#rows)" />
        <path d="M0 210 Q200 180 400 230" stroke="#c9b48a" stroke-width="6" fill="none" opacity=".7" />
        <path d="M120 0 L100 300" stroke="#6fb5d6" stroke-width="3" fill="none" opacity=".6" />
        <!-- murabba grid -->
        <g transform="translate(120 45) rotate(-4)">
          <rect x="0" y="0" width="200" height="200" fill="#0b1033" fill-opacity=".15" stroke="#22d3ee" stroke-width="2.5" />
          {killas.map((k) => {
            const c = (k - 1) % 5, r = Math.floor((k - 1) / 5);
            return (
              <g>
                <rect x={c * 40} y={r * 40} width="40" height="40" fill={highlight.has(k) ? '#f59e0b' : 'transparent'} fill-opacity=".45" stroke="#fde047" stroke-opacity=".85" stroke-width="1" />
                <text x={c * 40 + 20} y={r * 40 + 25} text-anchor="middle" font-size="12" font-weight="700" fill="#fff" style="paint-order:stroke" stroke="#000" stroke-width="2.5">{k}</text>
              </g>
            );
          })}
          <text x="100" y="-8" text-anchor="middle" font-size="11" font-weight="800" fill="#67e8f9">MURABBA 12</text>
        </g>
      </svg>
      <div class="pointer-events-none absolute inset-x-0 top-0 h-16 bg-gradient-to-b from-cyan-300/25 to-transparent" style="animation: scan 4s linear infinite"></div>

      <!-- area chip -->
      <div class="absolute bottom-3 left-3 rounded-xl border border-white/15 bg-slate-950/80 px-3 py-2 text-xs shadow-lg backdrop-blur">
        <div class="font-semibold text-amber-300">Selected: 4 killas</div>
        <div class="text-slate-300">4 Kanal · 0 Marla · ≈ 2.02 acres</div>
      </div>
      <!-- accuracy chip -->
      <div class="absolute right-3 top-3 rounded-xl border border-emerald-300/30 bg-emerald-500/15 px-3 py-1.5 text-[11px] font-semibold text-emerald-200 backdrop-blur">
        ● RTK FIX
      </div>
    </div>
  </div>

  <!-- Phone -->
  <div class="absolute -bottom-10 -left-6 hidden w-36 rotate-[-6deg] overflow-hidden rounded-[1.6rem] border-4 border-slate-800 bg-slate-900 shadow-2xl shadow-black/60 sm:block">
    <div class="bg-gradient-to-r from-[#1a237e] to-[#0b4a6f] px-2 py-1.5 text-[8px] font-bold text-white">Naqsha Zameen</div>
    <svg viewBox="0 0 120 200" class="block w-full">
      <rect width="120" height="200" fill="#3b5b2a" />
      <rect width="120" height="200" fill="url(#rows)" />
      <g transform="translate(15 40)">
        {Array.from({ length: 9 }, (_, i) => (
          <rect x={(i % 3) * 30} y={Math.floor(i / 3) * 30} width="30" height="30" fill={i === 4 ? '#f59e0b' : 'transparent'} fill-opacity=".5" stroke="#fde047" stroke-width=".8" />
        ))}
      </g>
      <circle cx="60" cy="85" r="5" fill="#22d3ee" stroke="#fff" stroke-width="2" />
      <circle cx="60" cy="85" r="14" fill="#22d3ee" fill-opacity=".2" />
    </svg>
    <div class="bg-slate-950 px-2 py-1.5 text-center text-[8px] font-semibold text-cyan-300">You are in Killa 13</div>
  </div>
</div>
