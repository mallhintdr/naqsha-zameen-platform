---
// Services strip for the /maps/ pages, phrased for the place the reader searched for.
import Icon from './Icon.astro';
import IconBox from './IconBox.astro';
import { TOPICS } from '../consultancy-topics';

interface Props { place: string; tehsil?: string }
const { place, tehsil } = Astro.props;
const where = tehsil ? `${place}, Tehsil ${tehsil}` : place;
const cards = [
  { href: '/services/rtk-survey/', icon: 'target', title: `RTK Measurement in ${place}`, text: `Centimetre-accurate GNSS RTK survey of your land in ${where}: demarcation, boundary disputes and plot layout.` },
  { href: '/services/drone-imagery/', icon: 'drone', title: 'Drone Imagery', text: `High-resolution aerial photos and orthomosaics of your fields, farm or housing scheme in ${place}.` },
  { href: '/services/land-consultancy/', icon: 'shield', title: 'Revenue Record Consultancy', text: `Mutation (intiqal), inheritance, partition and illegal possession (qabza) matters for land in ${place}.` },
  { href: '/services/digital-mapping/', icon: 'map', title: 'Digital Land Maps', text: 'Mouza, murabba and killa boundaries on satellite imagery with GPS and area measurement on your phone.' },
];
---
<section class="mx-auto mt-24 max-w-7xl px-4 sm:px-6 lg:px-8">
  <h2 class="reveal font-display text-center text-3xl font-extrabold text-white sm:text-4xl">Our Services in {place}</h2>
  <p class="urdu mt-3 text-center text-xl text-cyan-100/80" dir="rtl" lang="ur">پیمائش، ڈرون سروے اور ریونیو ریکارڈ کی رہنمائی</p>
  <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {cards.map((c) => (
      <a href={c.href} class="card reveal group flex flex-col">
        <IconBox name={c.icon} />
        <h3 class="mt-4 text-lg font-semibold leading-snug text-white">{c.title}</h3>
        <p class="mt-2 text-sm text-slate-400">{c.text}</p>
        <span class="mt-auto inline-flex items-center gap-1 pt-4 text-sm font-semibold text-cyan-300">Learn more <Icon name="arrow" class="size-4 transition group-hover:translate-x-1" /></span>
      </a>
    ))}
  </div>
  <ul class="reveal mt-8 flex flex-wrap justify-center gap-2">
    {TOPICS.map((t) => (
      <li><a href={`/services/land-consultancy/${t.slug}/`} class="inline-block rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm text-slate-200 transition hover:border-cyan-300/40 hover:text-white">{t.name}</a></li>
    ))}
  </ul>
</section>
