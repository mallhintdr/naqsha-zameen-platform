---
// Internal links between the revenue-consultancy pages (helps readers and search engines).
import Icon from './Icon.astro';
import IconBox from './IconBox.astro';
import { TOPICS } from '../consultancy-topics';
interface Props { current?: string; title?: string }
const { current, title = 'Revenue Matters We Advise On' } = Astro.props;
const items = TOPICS.filter((t) => t.slug !== current);
---
<section class="mx-auto mt-24 max-w-7xl px-4 sm:px-6 lg:px-8">
  <h2 class="reveal font-display text-center text-3xl font-extrabold text-white sm:text-4xl">{title}</h2>
  <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {items.map((t) => (
      <a href={`/services/land-consultancy/${t.slug}/`} class="card reveal group flex flex-col">
        <div class="flex items-center gap-3.5">
          <IconBox name={t.icon} />
          <h3 class="text-lg font-semibold leading-snug text-white">{t.name}</h3>
        </div>
        <p class="urdu mt-2 text-base text-cyan-100/80" dir="rtl" lang="ur">{t.urdu}</p>
        <p class="mt-2 text-sm text-slate-400">{t.description}</p>
        <span class="mt-auto inline-flex items-center gap-1 pt-4 text-sm font-semibold text-cyan-300">Read more <Icon name="arrow" class="size-4 transition group-hover:translate-x-1" /></span>
      </a>
    ))}
    {current && (
      <a href="/services/land-consultancy/" class="card reveal group flex flex-col justify-center">
        <h3 class="text-lg font-semibold text-white">All revenue record consultancy</h3>
        <span class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-cyan-300">Overview <Icon name="arrow" class="size-4 transition group-hover:translate-x-1" /></span>
      </a>
    )}
  </div>
</section>
