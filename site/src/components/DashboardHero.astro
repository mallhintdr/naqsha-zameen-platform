---
// Real Naqsha Zameen dashboard screenshots (chak 100 M, Lodhran), animated:
// the chak overview slowly zooms in, then cross-fades to the selected murabba's
// killa view, as a user would see it. The phone frame shows the same view on mobile.
// Screenshots are regenerated with frontend/e2e/capture-hero.mjs.
// Motion stops for visitors who ask for reduced motion (shows the killa view).
import { Image } from 'astro:assets';
import overview from '../assets/hero/dashboard-desktop.webp';
import killa from '../assets/hero/dashboard-killa.webp';
import phone from '../assets/hero/dashboard-phone.webp';
import { SITE } from '../site';
---
<div class="relative mx-auto w-full max-w-2xl lg:max-w-none">
  <div class="absolute -inset-10 -z-10 rounded-full bg-gradient-to-tr from-indigo-600/40 via-cyan-500/25 to-emerald-400/20 blur-3xl"></div>

  <!-- Desktop window -->
  <figure class="overflow-hidden rounded-2xl border border-white/15 bg-slate-900/80 shadow-2xl shadow-indigo-900/50 sm:rounded-3xl">
    <div class="flex items-center gap-2 border-b border-white/10 bg-gradient-to-r from-[#0b1033] via-[#1a237e] to-[#0b4a6f] px-4 py-2.5">
      <span class="size-2.5 rounded-full bg-rose-400"></span><span class="size-2.5 rounded-full bg-amber-300"></span><span class="size-2.5 rounded-full bg-emerald-400"></span>
      <span class="ml-3 truncate rounded-md border border-white/15 bg-white/10 px-2.5 py-0.5 text-[11px] font-medium text-slate-200">{SITE.dashboardHost}</span>
    </div>
    <div class="hero-stage relative aspect-[16/10] overflow-hidden bg-slate-800">
      <Image
        src={overview}
        alt="Naqsha Zameen dashboard: chak 100 M in Lodhran with every murabba outlined in red on satellite imagery"
        widths={[640, 960, 1280, 2000]}
        sizes="(min-width: 1024px) 50vw, 100vw"
        loading="eager"
        fetchpriority="high"
        class="hero-shot hero-overview absolute inset-0 size-full object-cover"
      />
      <Image
        src={killa}
        alt="The same chak zoomed into murabba 16: killa boundaries in gold dotted lines with murabba and killa numbers"
        widths={[640, 960, 1280, 2000]}
        sizes="(min-width: 1024px) 50vw, 100vw"
        loading="eager"
        class="hero-shot hero-killa absolute inset-0 size-full object-cover"
      />
      <div class="pointer-events-none absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-slate-950/70 to-transparent"></div>
      <figcaption class="absolute bottom-3 left-3 flex flex-wrap gap-1.5 text-[11px] font-semibold text-white">
        <span class="rounded-full border border-white/20 bg-slate-950/60 px-2.5 py-1 backdrop-blur">Live dashboard</span>
        <span class="rounded-full border border-cyan-300/40 bg-cyan-500/20 px-2.5 py-1 backdrop-blur">Chak 100 M · Lodhran</span>
      </figcaption>
    </div>
  </figure>

  <!-- Phone -->
  <div class="absolute -bottom-10 -right-2 hidden w-[26%] max-w-[170px] rotate-3 sm:block lg:-right-6">
    <div class="rounded-[1.6rem] border-4 border-slate-800 bg-slate-950 p-1 shadow-2xl shadow-black/60 ring-1 ring-white/10">
      <Image
        src={phone}
        alt="Naqsha Zameen on a phone: killa lines of murabba 16 on satellite imagery"
        widths={[200, 340]}
        sizes="170px"
        loading="lazy"
        class="aspect-[390/844] w-full rounded-[1.25rem] object-cover"
      />
    </div>
  </div>
</div>

<style>
  .hero-overview {
    transform-origin: 52% 40%;
    animation: hero-zoom 12s ease-in-out infinite;
  }
  .hero-killa {
    animation: hero-fade 12s ease-in-out infinite;
  }
  /* 0-45%: overview drifts closer; 45-55%: cross-fade; 55-90%: killa view; then back */
  @keyframes hero-zoom {
    0% { transform: scale(1); }
    50% { transform: scale(1.35); }
    100% { transform: scale(1.35); }
  }
  @keyframes hero-fade {
    0%, 42% { opacity: 0; transform: scale(1.06); }
    55% { opacity: 1; transform: scale(1.06); }
    88% { opacity: 1; transform: scale(1); }
    100% { opacity: 0; transform: scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-overview { animation: none; opacity: 0; }
    .hero-killa { animation: none; opacity: 1; }
  }
</style>
