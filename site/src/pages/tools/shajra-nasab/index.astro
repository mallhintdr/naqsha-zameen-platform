---
import Base from '../../../layouts/Base.astro';
import ShajraApp from '../../../tools/shajra/ShajraApp.tsx';
import { SITE } from '../../../site';

const ld = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Shajra Nasab & Inheritance Share Calculator',
  alternateName: 'شجرہ نسب و وراثت کیلکولیٹر',
  url: `${SITE.url}/tools/shajra-nasab/`,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any (web browser)',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'PKR' },
  provider: { '@id': `${SITE.url}/#organization` },
};
---
<Base
  title="Shajra Nasab & Inheritance Calculator"
  seoTitle="Shajra Nasab & Wirasat Share Calculator (Free) | Naqsha Zameen"
  description="Free online shajra nasab (family tree) and inheritance share calculator for Pakistan: build the family, get exact Sunni Hanafi shares with MFLO s.4, aul and radd, and print."
  schema={[ld]}
  crumbNames={['Tools', 'Shajra Nasab']}
>
  <section class="no-print relative isolate overflow-hidden pt-28 sm:pt-32">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6">
      <h1 class="font-display text-3xl font-extrabold text-white sm:text-5xl">Shajra Nasab &amp; Inheritance Calculator</h1>
      <p class="urdu mt-3 text-2xl text-cyan-100/90" dir="rtl" lang="ur">شجرہ نسب اور وراثتی حصص کا حساب</p>
      <p class="mx-auto mt-4 max-w-2xl text-slate-300">
        Build the family of the deceased, and the tool works out each heir's share (as a fraction, sihaam and percentage) with the reason for every
        share. Free, nothing to install; your case stays in your browser.
      </p>
    </div>
  </section>
  <section class="mx-auto mt-8 max-w-7xl px-2 sm:px-6 lg:px-8">
    <ShajraApp client:only="react" />
  </section>
  <section class="no-print mx-auto mt-10 max-w-4xl px-4 text-sm text-slate-400 sm:px-6">
    <p>Need help with an inheritance mutation (intiqal wirasat), partition or a disputed share? Our revenue record consultants can help:
      <a class="text-cyan-300 underline" href="/services/land-consultancy/inheritance-wirasat/">Inheritance (Wirasat) matters</a>.</p>
  </section>
</Base>

<style is:global>
  /* Every Urdu text in the tool (and its print / PDF) in Nastaliq. */
  .shajra .urdu, .shajra [lang='ur'] { font-family: 'Noto Nastaliq Urdu', serif; line-height: 2; }
  .shajra td .urdu, .shajra button.urdu { line-height: 1.6; }
  .shajra svg .urdu { font-family: 'Noto Nastaliq Urdu', serif; }
  /* The print sheet (title, chart, compact Urdu share table) is what gets printed / made into a PDF. */
  .print-sheet { display: none; }
  .shajra-title { text-decoration: underline; text-underline-offset: 6px; border: 0 !important; }
  @media print {
    body { background: #fff !important; }
    body * { visibility: hidden; }
    .print-sheet, .print-sheet * { visibility: visible; }
    .print-sheet { display: block !important; position: absolute; inset: 0 auto auto 0; width: 100%; color: #111; }
    .print-sheet .shajra-tree-print { width: 100% !important; height: auto !important; max-height: 150mm; background: #fff !important; }
    .print-body { display: flex; align-items: flex-start; gap: 4mm; }
    .print-tree { flex: 1 1 auto; min-width: 0; }
    .print-share-wrap { flex: 0 0 auto; max-width: 42%; }
    .print-kmf-note { font-family: 'Noto Nastaliq Urdu', serif; font-size: 8px; text-align: right; margin-top: 1mm; color: #555; }
    .print-share { border-collapse: collapse; font-size: 10px; line-height: 1.9; min-width: 70mm; }
    .print-share th, .print-share td { border: 1px solid #333; padding: 1px 6px; text-align: center; }
    .print-share th { background: #f1f1f1; font-weight: 700; }
    .print-share tr.total td { font-weight: 700; }
    .print-disclaimer { font-family: 'Noto Nastaliq Urdu', serif; font-size: 8px; text-align: center; margin-top: 3mm; color: #555; }
    #site-header, footer, a[aria-label='Chat on WhatsApp'], #consent { display: none !important; }
    table, tr { break-inside: avoid; }
  }
</style>
