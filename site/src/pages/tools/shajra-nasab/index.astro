---
import Base from '../../../layouts/Base.astro';
import ShajraApp from '../../../tools/shajra/ShajraApp.tsx';
import { SITE } from '../../../site';

const ld = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Shajra Nasab & Inheritance Share Calculator',
  alternateName: 'شجرہ نسب و وراثت کیلکولیٹر',
  url: `${SITE.url}/tools/shajra-nasab/`,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any (web browser)',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'PKR' },
  provider: { '@id': `${SITE.url}/#organization` },
};
// Changes with every website build: an old copy of this page in a browser cache reloads itself.
const BUILD = import.meta.env.DEV ? '' : Date.now().toString(36);
---
<Base
  title="Shajra Nasab & Inheritance Calculator"
  seoTitle="Shajra Nasab & Wirasat Share Calculator (Free) | Naqsha Zameen"
  description="Free online shajra nasab (family tree) and inheritance share calculator for Pakistan: build the family, get exact Sunni Hanafi shares with MFLO s.4, aul and radd, and print."
  schema={[ld]}
  crumbNames={['Tools', 'Shajra Nasab']}
>
  <section class="no-print relative isolate overflow-hidden pt-28 sm:pt-32">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6">
      <h1 class="font-display text-3xl font-extrabold text-white sm:text-5xl">Shajra Nasab &amp; Inheritance Calculator</h1>
      <p class="urdu mt-3 text-2xl text-cyan-100/90" dir="rtl" lang="ur">شجرہ نسب اور وراثتی حصص کا حساب</p>
      <p class="mx-auto mt-4 max-w-2xl text-slate-300">
        Build the family of the deceased, and the tool works out each heir's share (as a fraction, sihaam and percentage) with the reason for every
        share. Free, nothing to install; your case stays in your browser.
      </p>
    </div>
  </section>
  <section class="mx-auto mt-8 max-w-7xl px-2 sm:px-6 lg:px-8" id="shajra-app" data-build={BUILD}>
    <ShajraApp client:only="react" />
  </section>
  <script is:inline>
    // Every visitor sees the newest drawing: if the browser showed an older cached copy of this
    // page, fetch the current one and reload once.
    (function () {
      if (/[?&]pdf=1/.test(location.search)) return;
      var me = document.getElementById('shajra-app');
      var b = me && me.getAttribute('data-build');
      if (!b || !window.fetch) return;
      fetch(location.pathname, { cache: 'reload' }).then(function (r) { return r.ok ? r.text() : ''; }).then(function (t) {
        var m = /id="shajra-app" data-build="([a-z0-9]+)"/.exec(t) || /data-build="([a-z0-9]+)"/.exec(t);
        if (!m || m[1] === b) return;
        // At most one reload a minute, so a page that keeps changing can never loop.
        try { var last = +sessionStorage.getItem('shajra-reload') || 0; if (Date.now() - last < 60000) return; sessionStorage.setItem('shajra-reload', String(Date.now())); } catch (e) { return; }
        location.reload();
      }).catch(function () {});
    })();
  </script>
  <section class="no-print mx-auto mt-10 max-w-4xl px-4 text-sm text-slate-400 sm:px-6">
    <p>Need help with an inheritance mutation (intiqal wirasat), partition or a disputed share? Our revenue record consultants can help:
      <a class="text-cyan-300 underline" href="/services/land-consultancy/inheritance-wirasat/">Inheritance (Wirasat) matters</a>.</p>
  </section>
</Base>

<style is:global>
  /* Every Urdu text in the tool (and its print / PDF) in Nastaliq. */
  .shajra .urdu, .shajra [lang='ur'] { font-family: 'Noto Nastaliq Urdu', serif; line-height: 2; }
  .shajra td .urdu, .shajra button.urdu { line-height: 1.6; }
  .shajra svg .urdu { font-family: 'Noto Nastaliq Urdu', serif; }
  /* The print sheet (title, chart, compact Urdu share table) is what gets printed / made into a PDF. */
  .print-sheet { display: none; }
  .shajra-title { text-decoration: underline; text-underline-offset: 6px; border: 0 !important; }
  @media print {
    body { background: #fff !important; }
    body * { visibility: hidden; }
    .print-sheet, .print-sheet * { visibility: visible; }
    .print-sheet { display: block !important; position: absolute; inset: 0 auto auto 0; width: 100%; color: #111; }
    .print-sheet .shajra-tree-print { background: #fff !important; }
    /* The tree starts right under the title, centred on the page; the share table at the side or below. */
    .print-body.side { display: grid; grid-template-columns: minmax(0, 1fr); align-items: start; column-gap: 4mm; }
    .print-body.side[data-cols='3'] .print-tree { grid-column: 2; }
    .print-body.side[data-cols='3'] .print-share-wrap { grid-column: 3; grid-row: 1; justify-self: end; }
    .print-body.side[data-cols='2'] .print-share-wrap { grid-column: 2; grid-row: 1; justify-self: end; }
    .print-body.below { display: flex; flex-direction: column; align-items: center; gap: 4mm; }
    .print-tree { display: flex; justify-content: center; min-width: 0; }
    .print-attest-wrap { break-inside: avoid; margin-top: 3mm; }
    .print-declaration { font-family: 'Noto Nastaliq Urdu', serif; font-size: 8.5px; line-height: 2.1; text-align: justify; border: 1px solid #333; padding: 1mm 3mm; margin: 0 0 1mm; }
    .print-attest .att-cnic-label { font-size: 8px; color: #333; line-height: 1.6; }
    .print-attest .cnic-boxes { display: inline-flex; align-items: center; gap: 0; direction: ltr; font-family: 'Noto Sans', Arial, sans-serif; }
    .print-attest .cnic-box { display: inline-flex; width: 3.6mm; height: 4.6mm; border: 0.8px solid #222; margin-left: -0.8px; align-items: center; justify-content: center; font-size: 9px; line-height: 1; }
    .print-attest .cnic-dash { display: inline-block; width: 2.2mm; text-align: center; font-size: 9px; line-height: 1; }
    .print-attest { width: 100%; margin-top: 1mm; border-collapse: collapse; table-layout: fixed; font-size: 10px; line-height: 1.9; break-inside: avoid; }
    .print-attest td { text-align: center; vertical-align: top; padding: 0 3mm; }
    .print-attest .att-note { font-size: 8.5px; color: #333; }
    .print-attest .att-thumb { width: 26mm; height: 16mm; margin: 1mm auto; border: 1px dashed #555; font-size: 7.5px; color: #777; display: flex; align-items: flex-end; justify-content: center; }
    .print-attest tr.att-name td { padding-top: 1mm; }
    .print-attest tr.att-cnic td { white-space: nowrap; }
    .print-kmf-note { font-family: 'Noto Nastaliq Urdu', serif; font-size: 8px; text-align: right; margin-top: 1mm; color: #555; }
    .print-share { border-collapse: collapse; font-size: 10px; line-height: 1.9; min-width: 70mm; }
    .print-share th, .print-share td { border: 1px solid #333; padding: 1px 6px; text-align: center; white-space: nowrap; }
    .print-share th { background: #f1f1f1; font-weight: 700; }
    .print-share tr.total td { font-weight: 700; }
    .print-disclaimer { font-family: 'Noto Nastaliq Urdu', serif; font-size: 8px; text-align: center; margin-top: 3mm; color: #555; }
    #site-header, footer, a[aria-label='Chat on WhatsApp'], #consent { display: none !important; }
    table, tr { break-inside: avoid; }
  }
</style>
