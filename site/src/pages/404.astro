---
import Base from '../layouts/Base.astro';
---
<Base title="Page Not Found" noindex>
  <section class="flex min-h-[70vh] flex-col items-center justify-center px-4 pt-24 text-center">
    <p class="font-display text-8xl font-extrabold text-gradient">404</p>
    <h1 class="mt-4 text-2xl font-bold text-white">This Plot Isn't on Our Map.</h1>
    <p class="mt-2 text-slate-400">The page you're looking for doesn't exist.</p>
    <a href="/" class="btn-primary mt-8">Back to home</a>
  </section>
</Base>
