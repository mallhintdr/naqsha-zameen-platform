---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import IconBox from '../components/IconBox.astro';
import MapMock from '../components/MapMock.astro';
import CTA from '../components/CTA.astro';
import { SITE } from '../site';

const groups = [
  {
    title: 'Navigate',
    items: [
      ['search', 'Tehsil, chak & murabba pickers with instant search'],
      ['pin', 'Live GPS location with accuracy and “you are in killa” info'],
      ['compass', 'Compass, map rotation and go-to-coordinates'],
      ['satellite', 'Satellite, hybrid and street base maps'],
    ],
  },
  {
    title: 'Measure & Draw',
    items: [
      ['ruler', 'Area and length in acres, kanal, marla and karam'],
      ['map', 'Guided drawing of fields, roads and boundaries'],
      ['layers', 'Shajra overlay and numbered killa grid'],
      ['download', 'Save layers and reopen them on any device'],
    ],
  },
  {
    title: 'Account & Support',
    items: [
      ['bolt', 'Free 24-hour trial, then monthly or yearly plans'],
      ['shield', 'Secure login with device protection'],
      ['phoneApp', 'Works in any phone or computer browser'],
      ['users', 'Built-in guided tours and WhatsApp support'],
    ],
  },
];
---
<Base title="The Dashboard" seoTitle="Naqsha Zameen Dashboard – Mouza & Killa Maps on Your Phone | Punjab Land Records Map" description="Naqsha Zameen dashboard: mouza, murabba and killa maps on satellite imagery with GPS, measurement in kanal and marla, drawing tools and saved layers.">
  <section class="relative isolate overflow-hidden pt-32 sm:pt-40">
    <div class="grid-bg absolute inset-0 -z-10"></div>
    <div class="mx-auto grid max-w-7xl items-center gap-16 px-4 sm:px-6 lg:grid-cols-2 lg:px-8">
      <div>
        <span class="eyebrow">{SITE.dashboardHost}</span>
        <h1 class="font-display mt-6 text-4xl font-extrabold text-white sm:text-6xl">The Land Record, <span class="text-gradient">Made Visual.</span></h1>
        <p class="mt-5 max-w-xl text-lg text-slate-300">Everything the patwari's register describes — mouza, murabba, killa — drawn on today's satellite imagery and available on your phone.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={SITE.registerUrl} class="btn-primary">Start free trial <Icon name="arrow" class="size-4" /></a>
          <a href={SITE.loginUrl} class="btn-ghost">Login</a>
        </div>
      </div>
      <div class="pb-12 lg:pb-0"><MapMock /></div>
    </div>
  </section>

  <section class="mx-auto mt-28 max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-6 lg:grid-cols-3">
      {groups.map((g) => (
        <div class="card reveal">
          <h2 class="font-display text-xl font-bold text-white">{g.title}</h2>
          <ul class="mt-5 space-y-4">
            {g.items.map(([i, t]) => (
              <li class="flex gap-3 text-slate-300"><IconBox name={i} size="sm" /><span class="pt-2">{t}</span></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto mt-24 max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="reveal grid items-center gap-10 rounded-[2rem] border border-white/10 bg-gradient-to-br from-white/[0.06] to-white/[0.02] p-8 sm:p-12 lg:grid-cols-2">
      <div>
        <span class="eyebrow">For resellers</span>
        <h2 class="font-display mt-4 text-3xl font-extrabold text-white">Become a Naqsha Zameen Partner</h2>
        <p class="mt-3 text-slate-300">Sub-admin partners get their own console to create customers, manage renewals and track billing in their area.</p>
      </div>
      <ul class="grid gap-3 sm:grid-cols-2">
        {['Own customer console', 'Trial accounts for leads', 'Renewal tracking', 'Monthly billing statements'].map((t) => (
          <li class="flex items-center gap-2 rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-slate-200"><Icon name="check" class="size-4 text-emerald-400" />{t}</li>
        ))}
      </ul>
    </div>
  </section>

  <CTA title="See Your Chak on the Map Today" waText="Assalam-o-Alaikum, I want dashboard access / partnership details." />
</Base>
