---
import { SITE } from '../site';
const target = `${SITE.url}/maps/`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting to Mouza Maps &amp; Dashboard | {SITE.brand}</title>
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content="0;url=/maps/" />
    <script is:inline>
      window.location.replace('/maps/' + window.location.search + window.location.hash);
    </script>
  </head>
  <body style="background:#070b24;color:#e2e8f0;font-family:system-ui,sans-serif;padding:2rem;text-align:center;">
    <p>Redirecting to <a href="/maps/" style="color:#67e8f9;">Mouza Maps &amp; Dashboard</a>…</p>
  </body>
</html>
