---
import Service from '../../layouts/Service.astro';
---
<Service
  title="RTK Land Measurement"
  seoTitle="RTK Land Survey & Measurement in Punjab – Centimetre Accuracy, Printed Maps | Naqsha Zameen"
  slug="rtk-survey"
  urdu="سینٹی میٹر تک درست زمینی پیمائش"
  description="Centimetre-level GNSS RTK land surveys in Punjab for demarcation, boundary disputes, plot layout and housing schemes."
  icon="target"
  accent="from-emerald-500 to-teal-400"
  lead="Our field team uses survey-grade GNSS RTK receivers to measure and mark your land with centimetre-level precision — and delivers the results as high-resolution printed maps on large sheets, with your survey drawn over satellite imagery."
  waText="Assalam-o-Alaikum, I want to book an RTK land measurement."
  benefits={[
    { icon: 'target', title: 'Centimetre-Level Accuracy', text: 'Real-time kinematic correction gives survey-grade coordinates, far beyond phone GPS.' },
    { icon: 'pin', title: 'Demarcation on Ground', text: 'We stake out killa corners and boundaries so everyone can see the line.' },
    { icon: 'map', title: 'Matched to the Map', text: 'Measured points are plotted against mouza and killa boundaries in the dashboard.' },
    { icon: 'file', title: 'Large Printed Maps', text: 'High-resolution maps of your survey on satellite imagery, printed on large sheets on our plotter — ready to share with family, buyers or a lawyer.' },
    { icon: 'clock', title: 'Fast Turnaround', text: 'Small jobs are usually measured in a single visit.' },
    { icon: 'users', title: 'Experienced Team', text: 'Surveyors who understand the local patwari system and killa layout.' },
  ]}
  deliverables={[
    'On-site RTK measurement of corners and boundaries',
    'Boundary pegs / markings where required',
    'Coordinate list and calculated areas (acre, kanal, marla)',
    'High-resolution printed map on a large sheet: survey lines, killa boundaries and satellite imagery',
    'Digital copy of the map (PDF) and files (KMZ / GeoJSON)',
    'Points loaded to your Naqsha Zameen account on request',
  ]}
  useCases={['Land demarcation', 'Boundary disputes', 'Partition between heirs', 'Plot & road layout', 'Housing schemes', 'Construction setting-out', 'Topographic points']}
  process={[
    { title: 'Share Location', text: 'Send chak, murabba/killa and a pin on WhatsApp.' },
    { title: 'Get a Quote', text: 'We confirm scope, date and price before visiting.' },
    { title: 'Field Survey', text: 'Our team measures and marks the land with RTK.' },
    { title: 'Receive Your Map', text: 'Get a large printed high-resolution map of the survey, plus digital files.' },
  ]}
  faqs={[
    { q: 'How is RTK different from phone GPS?', a: 'Phone GPS is typically off by several metres. RTK uses a correction signal to reach centimetre-level accuracy, which is what boundary work requires.' },
    { q: 'Do you measure according to the revenue record?', a: 'We measure the ground and compare it with the mouza / killa layout. Official demarcation by the revenue department is a separate legal process; our results help you prepare for it.' },
    { q: 'What does a survey cost?', a: 'Pricing depends on area, location and deliverables. Send details on WhatsApp for a quick quote.' },
  ]}
/>
