import Service from '../../layouts/Service.astro';
---
<Service
  title="Land Dispute Consultancy"
  seoTitle="Land Dispute Consultancy in Punjab – Record Verification, Boundary & Partition Disputes | Naqsha Zameen"
  slug="land-consultancy"
  urdu="زمینی تنازعات میں ماہرانہ مشاورت"
  description="Expert consultancy for land disputes in Punjab: revenue record verification, boundary and encroachment disputes, partition between heirs, pre-purchase checks and technical evidence for courts and revenue offices."
  icon="shield"
  accent="from-violet-500 to-fuchsia-400"
  lead="Land disputes are won on facts: what the revenue record says, where the boundary really runs on the ground, and how the two match. Our senior consultants combine land-record expertise with RTK measurement, drone imagery and digital mouza maps to give you a clear, evidence-based picture of your case, and a practical way forward, working alongside your advocate."
  waText="Assalam-o-Alaikum, I need consultancy about a land dispute."
  ctaLabel="Book a confidential consultation"
  benefits={[
    { icon: 'file', title: 'Record Verification', text: 'We study fard, jamabandi, intiqal (mutation), khasra girdawari and aks shajra to establish what the record actually shows.' },
    { icon: 'target', title: 'Boundary & Encroachment Analysis', text: 'RTK measurement and killa maps show exactly where the line is, and who is on whose land.' },
    { icon: 'users', title: 'Partition Between Heirs', text: 'Fair, measured division plans for inherited land, with each share shown on the map.' },
    { icon: 'search', title: 'Pre-Purchase Due Diligence', text: 'Before you buy, we check ownership, the shajra position and the ground, so there are no surprises later.' },
    { icon: 'layers', title: 'Technical Evidence', text: 'Clear expert maps, measurement reports and drone imagery that support your case in court or before revenue officers.' },
    { icon: 'shield', title: 'Discreet, Senior Advice', text: 'Confidential handling by experienced professionals who know the patwari and revenue system.' },
  ]}
  deliverables={[
    'Review of your documents and the revenue record for the land',
    'Written opinion on the dispute: facts, record position and risks',
    'Site verification with RTK measurement and, where useful, drone imagery',
    'Expert map comparing the record (killa / shajra layout) with the ground',
    'Partition or settlement proposal with each share measured and mapped',
    'Coordination with your advocate and guidance for revenue proceedings',
  ]}
  useCases={['Boundary disputes', 'Encroachment / qabza', 'Partition between heirs', 'Mutation (intiqal) issues', 'Record mismatch with ground', 'Pre-purchase checks', 'Court & revenue evidence', 'Housing scheme land']}
  process={[
    { title: 'Confidential Consultation', text: 'Tell us the issue on WhatsApp or in a meeting; share the documents you have.' },
    { title: 'Record Review', text: 'We examine the revenue record and map the land on the dashboard.' },
    { title: 'Ground Verification', text: 'Our team measures the site with RTK and documents it with drone imagery if needed.' },
    { title: 'Report & Way Forward', text: 'You receive a clear report, expert maps and recommended next steps.' },
  ]}
  faqs={[
    { q: 'Are you lawyers?', a: 'No. We are land-record and survey specialists. We establish the facts and prepare technical evidence; your advocate handles the legal case, and we work closely with them.' },
    { q: 'Which documents should I bring?', a: 'Whatever you have: fard, jamabandi copy, mutation (intiqal), registry, aks shajra, old maps or court papers. If something is missing we will tell you how to obtain it.' },
    { q: 'Can your maps be used in court?', a: 'Our measurement reports and maps are prepared to be clear and verifiable and are commonly used as supporting evidence. Whether and how they are admitted is decided by the court or revenue officer.' },
    { q: 'Is my case kept confidential?', a: 'Yes. Documents and details are used only for your case and are not shared without your permission.' },
    { q: 'What does consultancy cost?', a: 'It depends on the case and the work needed. Share a short description on WhatsApp for an initial assessment and a quote.' },
  ]}
