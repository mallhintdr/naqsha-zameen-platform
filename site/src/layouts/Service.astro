---
// Shared layout for the three service pages.
import Base from './Base.astro';
import Icon from '../components/Icon.astro';
import IconBox from '../components/IconBox.astro';
import CTA from '../components/CTA.astro';
import FAQ from '../components/FAQ.astro';
import AdSlot from '../components/AdSlot.astro';
import { SITE, waLink } from '../site';

interface Props {
  title: string;
  seoTitle?: string;
  slug: string;
  urdu: string;
  description: string;
  icon: string;
  accent: string;
  lead: string;
  benefits: { icon: string; title: string; text: string }[];
  deliverables: string[];
  useCases: string[];
  process: { title: string; text: string }[];
  faqs: { q: string; a: string }[];
  waText: string;
}
const p = Astro.props;
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${SITE.url}/services/${p.slug}/#service`,
  name: p.title,
  alternateName: p.urdu,
  serviceType: p.title,
  description: p.description,
  url: `${SITE.url}/services/${p.slug}/`,
  provider: { '@id': `${SITE.url}/#organization` },
  areaServed: { '@type': 'AdministrativeArea', name: 'Punjab, Pakistan' },
  availableChannel: { '@type': 'ServiceChannel', serviceUrl: waLink(p.waText), availableLanguage: ['en', 'ur'] },
  hasOfferCatalog: { '@type': 'OfferCatalog', name: `${p.title} deliverables`, itemListElement: p.deliverables.map((d) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: d } })) },
};
---
<Base title={p.title} seoTitle={p.seoTitle} description={p.description} schema={[serviceLd]}>
  <section class="relative isolate overflow-hidden pt-32 sm:pt-40">
    <div class="grid-bg absolute inset-0 -z-10"></div>
    <div class={`absolute -top-40 left-1/2 -z-10 h-[500px] w-[900px] -translate-x-1/2 rounded-full bg-gradient-to-br ${p.accent} opacity-25 blur-3xl`}></div>
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6">
      <IconBox name={p.icon} size="xl" class="mx-auto" />
      <h1 class="font-display mt-6 text-4xl font-extrabold text-white sm:text-6xl">{p.title}</h1>
      <p class="urdu mt-3 text-2xl text-cyan-100/90" dir="rtl" lang="ur">{p.urdu}</p>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-slate-300">{p.lead}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={waLink(p.waText)} target="_blank" rel="noopener" class="btn-primary"><Icon name="whatsapp" class="size-5" /> Get a quote on WhatsApp</a>
        <a href={`tel:${SITE.phoneTel}`} class="btn-ghost"><Icon name="phone" class="size-5" /> {SITE.phoneDisplay}</a>
      </div>
    </div>
  </section>

  <section class="mx-auto mt-24 max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {p.benefits.map((b) => (
        <div class="card reveal">
          <div class="flex items-center gap-3.5">
            <IconBox name={b.icon} />
            <h2 class="text-xl font-semibold leading-snug text-white">{b.title}</h2>
          </div>
          <p class="mt-3 text-slate-400">{b.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto mt-24 grid max-w-7xl gap-6 px-4 sm:px-6 lg:grid-cols-2 lg:px-8">
    <div class="card reveal">
      <h2 class="font-display text-2xl font-bold text-white">What You Receive</h2>
      <ul class="mt-6 space-y-3">
        {p.deliverables.map((d) => (
          <li class="flex gap-3 text-slate-300"><span class="mt-0.5 inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-emerald-400/15 text-emerald-300"><Icon name="check" class="size-4" /></span>{d}</li>
        ))}
      </ul>
    </div>
    <div class="card reveal">
      <h2 class="font-display text-2xl font-bold text-white">Typical Uses</h2>
      <ul class="mt-6 flex flex-wrap gap-2">
        {p.useCases.map((u) => <li class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm text-slate-200">{u}</li>)}
      </ul>
    </div>
  </section>

  <section class="mx-auto mt-24 max-w-7xl px-4 sm:px-6 lg:px-8">
    <h2 class="reveal font-display text-center text-3xl font-extrabold text-white sm:text-4xl">How It Works</h2>
    <ol class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {p.process.map((s, i) => (
        <li class="card reveal">
          <span class={`inline-flex size-10 items-center justify-center rounded-full bg-gradient-to-br ${p.accent} font-bold text-white`}>{i + 1}</span>
          <h3 class="mt-4 text-lg font-semibold text-white">{s.title}</h3>
          <p class="mt-1.5 text-slate-400">{s.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <slot />
  <AdSlot position="inContent" />
  <FAQ items={p.faqs} />
  <CTA waText={p.waText} />
</Base>
