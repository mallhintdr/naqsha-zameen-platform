---
import Base from './Base.astro';
interface Props {
  title: string;
  description: string;
  updated: string;
}
const { title, description, updated } = Astro.props;
---
<Base title={title} description={description}>
  <article class="mx-auto max-w-3xl px-4 pt-32 sm:px-6 sm:pt-40">
    <h1 class="font-display text-4xl font-extrabold text-white sm:text-5xl">{title}</h1>
    <p class="mt-3 text-sm text-slate-400">Last updated: {updated}</p>
    <div class="legal mt-10 space-y-4 text-slate-300">
      <slot />
    </div>
  </article>
</Base>

<style is:global>
  .legal h2 { margin-top: 2.5rem; font-family: var(--font-display); font-size: 1.4rem; font-weight: 700; color: #fff; }
  .legal ul { list-style: disc; padding-left: 1.4rem; }
  .legal li { margin: 0.35rem 0; }
  .legal a { color: #67e8f9; text-decoration: underline; text-underline-offset: 3px; }
</style>
